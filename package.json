{
    "name": "notely",
    "productName": "Notely",
    "version": "1.0.1",
    "description": "Notely is local-first desktop app for projects, notes and tasks. Offline, private, built with Electron + React + TypeScript.",
    "author": {
        "name": "Notely"
    },
    "license": "MIT",
    "private": true,
    "main": "dist-electron/main.js",
    "scripts": {
        "predev": "node scripts/reclaim.mjs",
        "dev": "node scripts/dev.mjs",
        "dev:web": "vite",
        "dev:electron": "node scripts/build.mjs && electron .",
        "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.electron.json",
        "lint": "eslint . --max-warnings 0",
        "test": "vitest run",
        "test:watch": "vitest",
        "build": "npm run typecheck && node scripts/build.mjs",
        "screenshots": "node scripts/screenshots.mjs",
        "assets": "node scripts/generate-assets.mjs",
        "verify:exe": "node scripts/verify-exe.mjs",
        "predev:web": "node scripts/reclaim.mjs",
        "postdev": "node scripts/reclaim.mjs",
        "postdev:web": "node scripts/reclaim.mjs",
        "postdev:electron": "node scripts/reclaim.mjs",
        "dist:win": "npm run build && node scripts/package-win.mjs nsis",
        "dist:portable": "npm run build && node scripts/package-win.mjs portable",
        "dist:all": "npm run build && node scripts/package-win.mjs nsis portable",
        "clean": "node scripts/clean.mjs",
        "reinstall": "node scripts/clean.mjs && npm ci",
        "stage:app": "node scripts/build.mjs && node scripts/stage-app.mjs"
    },
    "dependencies": {
        "@fontsource/inter": "5.3.0",
        "dexie": "4.4.6",
        "dexie-react-hooks": "^1.1.7",
        "lucide-react": "0.468.0",
        "react": "19.1.1",
        "react-dom": "19.1.1"
    },
    "devDependencies": {
        "@eslint/js": "9.39.5",
        "@testing-library/jest-dom": "6.9.1",
        "@testing-library/react": "16.3.3",
        "@testing-library/user-event": "14.6.8",
        "@types/node": "22.18.0",
        "@types/react": "19.1.10",
        "@types/react-dom": "19.1.7",
        "@vitejs/plugin-react": "5.2.0",
        "electron": "38.8.6",
        "electron-builder": "26.15.3",
        "eslint": "9.39.5",
        "eslint-plugin-react-hooks": "7.1.1",
        "fake-indexeddb": "6.2.6",
        "globals": "17.13.0",
        "jsdom": "30.1.3",
        "playwright": "1.56.1",
        "typescript": "5.9.3",
        "typescript-eslint": "8.72.0",
        "vite": "7.3.7",
        "vitest": "3.2.7"
    }
}
